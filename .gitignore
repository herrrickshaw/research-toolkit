*.jsonl
*.log
stage/
__pycache__/
*.pyc

# Contains real personal document titles/paths (CVs, bank statements, tax
# filings, ID docs) via its topic/path columns - this repo is PUBLIC, never commit it.
document_catalog.duckdb
*.duckdb.wal
topic_sweep_*.md

# ZOTERO_STAGING_DIR leftovers - actual downloaded file content (not just
# metadata), left behind when a run gets interrupted before its per-file
# cleanup. Should be empty in steady state; never commit whatever's in it.
gdrive_stage/

# Local graphify tool cache - regenerable, gitignored account-wide (see ~/.gitignore).
graphify-out/

# pdf_to_markdown.py output: real extracted document text (titles, personal
# CVs, tax/ID docs, etc. per categorize.py's own PERSONAL_KEYWORDS list) -
# same reason document_catalog.duckdb is excluded above. Never commit it.
md_corpus/
pdf2md_stage/
daily_pdf_to_md.log
full_backfill_run.log
sweep_run.log
